generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  BigInt               @id @default(autoincrement())
  firebase_id         String               @unique
  full_name           String
  email               String               @unique
  phone               String               @unique
  gender              Gender
  role                UserRole
  city                String
  birth_date          DateTime             @db.Date
  photo_url           String?
  is_active           Boolean              @default(true)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  adminProfile        AdminProfile?
  coachProfile        CoachProfile?
  multimedia          Multimedia[]
  notification        Notification[]
  organizationProfile OrganizationProfile?
  payments            Payment[]
  playerProfile       PlayerProfile?
  created_teams       Team[]               @relation("CreatedTeams")
  send_invites        TeamInvite[]         @relation("InvitedByUser")
  received_invites    TeamInvite[]         @relation("InvitedUser")
  team_memberships    TeamMember[]
}

model PlayerProfile {
  id              BigInt          @id
  userId          BigInt          @unique
  preferred_games GameType[]
  guardianId      BigInt?
  created_at      DateTime        @default(now())
  participants    Participant[]
  bookings        PlayerBooking[]
  guardian        Guardian?       @relation(fields: [guardianId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guardian {
  id         BigInt          @id @default(autoincrement())
  full_name  String
  email      String          @unique
  phone      String          @unique
  relation   Relation        @default(FATHER)
  created_at DateTime        @default(now())
  players    PlayerProfile[]
}

model CoachProfile {
  id         BigInt         @id
  user_id    BigInt         @unique
  bio        String?
  experience String?
  created_at DateTime       @default(now())
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  services   CoachService[]
}

model CoachService {
  id          BigInt          @id @default(autoincrement())
  coach_id    BigInt
  title       String
  description String?
  price       Float?          @default(0)
  duration    Int?
  created_at  DateTime        @default(now())
  coach       CoachProfile    @relation(fields: [coach_id], references: [id], onDelete: Cascade)
  bookings    PlayerBooking[]
}

model PlayerBooking {
  id        BigInt        @id @default(autoincrement())
  playerId  BigInt
  serviceId BigInt
  status    BookingStatus @default(REQUESTED)
  price     Float?        @default(0)
  booked_at DateTime      @default(now())
  start_at  DateTime?
  end_at    DateTime?
  notes     String?
  payments  Payment[]
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  service   CoachService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Team {
  id              BigInt        @id @default(autoincrement())
  name            String        @unique
  logo            String?
  game            GameType
  created_by_id   BigInt?
  created_by_role UserRole
  created_at      DateTime      @default(now())
  is_deleted      Boolean       @default(false)
  participants    Participant[]
  created_by      User?         @relation("CreatedTeams", fields: [created_by_id], references: [id])
  team_invites    TeamInvite[]
  members         TeamMember[]
}

model TeamInvite {
  id            BigInt         @id @default(autoincrement())
  team_id       BigInt
  invited_id    BigInt
  invited_role  UserRole
  invited_email String?
  invited_by_id BigInt
  status        ApprovalStatus @default(PENDING)
  created_at    DateTime       @default(now())
  expires_at    DateTime?
  invited_by    User           @relation("InvitedByUser", fields: [invited_by_id], references: [id], onDelete: Cascade)
  invited       User           @relation("InvitedUser", fields: [invited_id], references: [id], onDelete: Cascade)
  team          Team           @relation(fields: [team_id], references: [id], onDelete: Cascade)
}

model TeamMember {
  teamId      BigInt
  userId      BigInt
  roleInTeam  TeamMemberRole @default(PLAYER)
  invitedAt   DateTime       @default(now())
  respondedAt DateTime?
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model CompetitionType {
  id                  BigInt        @id @default(autoincrement())
  name                String
  rules               String
  sport               GameType
  createdByAdmin      BigInt?
  min_player_per_team Int
  max_player_per_team Int
  created_at          DateTime      @default(now())
  competitions        Competition[]
}

model Competition {
  id                    BigInt              @id @default(autoincrement())
  name                  String
  typeId                BigInt
  start_date            DateTime
  end_date              DateTime
  venue_name            String
  venue_address         String
  venue_city            String
  organization_id       BigInt
  approval_status       ApprovalStatus      @default(PENDING)
  fee_type              FeeType
  fee_amount            Float               @default(0)
  is_fee_per_person     Boolean?            @default(false)
  winner_participant_id BigInt?
  min_age               Int
  max_age               Int
  max_teams             Int?
  hasGroupStage         Boolean             @default(false)
  eliminationType       EliminationType     @default(KNOCKOUT)
  created_at            DateTime            @default(now())
  organization          OrganizationProfile @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  type                  CompetitionType     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  groups                CompetitionGroup[]
  matches               Match[]
  multimedia            Multimedia[]
  participants          Participant[]
}

model Participant {
  id                    BigInt            @id @default(autoincrement())
  competition_id        BigInt
  type                  ParticipantType
  team_id               BigInt?
  player_id             BigInt?
  registered_at         DateTime          @default(now())
  confirmed_at          DateTime?
  qrCode                String?
  payment_required      Float?
  status                ApprovalStatus    @default(PENDING)
  group_memberships     GroupMembership[]
  standing              GroupStanding[]
  match_as_participant1 Match[]           @relation("MatchParticipant1")
  match_as_participant2 Match[]           @relation("MatchParticipant2")
  wonMatches            Match[]           @relation("MatchWinner")
  competition           Competition       @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  player                PlayerProfile?    @relation(fields: [player_id], references: [id])
  team                  Team?             @relation(fields: [team_id], references: [id])
  payments              Payment[]

  @@unique([competition_id, team_id])
  @@unique([competition_id, player_id])
}

model CompetitionGroup {
  id             BigInt            @id @default(autoincrement())
  competition_id BigInt
  name           String
  competition    Competition       @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  members        GroupMembership[]
  standing       GroupStanding[]
  matches        Match[]
}

model GroupMembership {
  group_id       BigInt
  participant_id BigInt
  points         Int              @default(0)
  wins           Int              @default(0)
  losses         Int              @default(0)
  group          CompetitionGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  participant    Participant      @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@id([group_id, participant_id])
}

model Match {
  id                    BigInt            @id @default(autoincrement())
  competition_id        BigInt
  group_id              BigInt?
  stage                 MatchStage?
  status                MatchStatus       @default(SCHEDULED)
  scheduled_at          DateTime?
  venue_name            String?
  venue_address         String?
  venue_city            String?
  round                 Int?
  next_match_id         BigInt?
  next_match_slot       Int?
  participant1_id       BigInt
  participant2_id       BigInt?
  score_participant1    Int?              @default(0)
  score_participant2    Int?              @default(0)
  winner_participant_id BigInt?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  competition           Competition       @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  group                 CompetitionGroup? @relation(fields: [group_id], references: [id])
  nextMatch             Match?            @relation("NextMatch", fields: [next_match_id], references: [id])
  previousMatches       Match[]           @relation("NextMatch")
  participant1          Participant       @relation("MatchParticipant1", fields: [participant1_id], references: [id], onDelete: Cascade)
  participant2          Participant?      @relation("MatchParticipant2", fields: [participant2_id], references: [id])
  winner                Participant?      @relation("MatchWinner", fields: [winner_participant_id], references: [id])
}

model GroupStanding {
  id            BigInt           @id @default(autoincrement())
  groupId       BigInt
  participantId BigInt
  points        Int              @default(0)
  wins          Int              @default(0)
  losses        Int              @default(0)
  group         CompetitionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([groupId, participantId])
}

model Payment {
  id             BigInt         @id @default(autoincrement())
  participant_id BigInt?
  bookingId      BigInt?
  user_id        BigInt
  amount         Float          @default(0)
  currency       String?        @default("EGP")
  method         String?
  created_at     DateTime       @default(now())
  due_date       DateTime?
  status         PaymentStatus  @default(PENDING)
  payment_info   Json?
  booking        PlayerBooking? @relation(fields: [bookingId], references: [id])
  participant    Participant?   @relation(fields: [participant_id], references: [id])
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id                     BigInt                @id
  user_id                BigInt                @unique
  created_t              DateTime              @default(now())
  user                   User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  approved_organizations OrganizationProfile[]
}

model OrganizationProfile {
  id                  BigInt           @id
  user_id             BigInt           @unique
  owner_name          String
  type                OrganizationType
  district            String
  street_address      String
  address_description String?
  google_map_link     String?
  approval_status     ApprovalStatus   @default(PENDING)
  approved_by         BigInt?
  created_at          DateTime         @default(now())
  competitions        Competition[]
  admin               AdminProfile?    @relation(fields: [approved_by], references: [id])
  user                User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Multimedia {
  id             BigInt      @id @default(autoincrement())
  competition_id BigInt
  title          String
  description    String?
  media_type     MediaType
  url            String
  uploaded_by_id BigInt
  created_at     DateTime    @default(now())
  competition    Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  uploaded_by    User        @relation(fields: [uploaded_by_id], references: [id], onDelete: Cascade)
}

model Notification {
  id             BigInt   @id @default(autoincrement())
  user_id        BigInt
  firebase_token String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, firebase_token])
}

enum ApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
  PENDING_PAYMENT
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  ORGANIZATION
  PLAYER
  COACH
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  FACEBOOK
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELED
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum Relation {
  FATHER
  MOTHER
  OTHER
}

enum GameType {
  FOOTBALL
  BASKETBALL
  HANDBALL
  PLAYSTATION
}

enum EliminationType {
  KNOCKOUT
  GROUP_STAGE
}

enum MatchStage {
  GROUP_STAGE
  KNOCKOUT
  FINAL
  BYE
}

enum TeamMemberRole {
  PLAYER
  CAPTAIN
}

enum FeeType {
  FREE
  PAID
}

enum ParticipantType {
  TEAM
  PLAYER
}

enum OrganizationType {
  CLUB
  YOUTH_CENTER
  STATUDIM
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}
