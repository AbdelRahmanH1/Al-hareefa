generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===============================
// Enums
// ===============================
enum ApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
  PENDING_PAYMENT
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  ORGANIZATION
  PLAYER
  COACH
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  FACEBOOK
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELED
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum Relation {
  FATHER
  MOTHER
  OTHER
}

enum GameType {
  FOOTBALL
  BASKETBALL
  HANDBALL
  PLAYSTATION
}

enum EliminationType {
  SINGLE_ELIMINATION
  KNOCKOUT
}

enum MatchStage {
  GROUP_STAGE
  KNOCKOUT 
  FINAL 
  BYE 
}

enum TeamMemberRole {
  PLAYER
  CAPTAIN
}

enum FeeType {
  FREE
  PAID
}

enum ParticipantType {
  TEAM
  PLAYER
}

enum OrganizationType {
  CLUB
  YOUTH_CENTER
  STATUDIM
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// ===============================
// Users
// ===============================
model User {
  id          BigInt   @id @default(autoincrement())
  firebase_id String   @unique
  full_name   String
  email       String   @unique
  phone       String   @unique
  gender      Gender
  role        UserRole
  city        String
  birth_date  DateTime @db.Date
  photo_url String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // profiles
  playerProfile       PlayerProfile?
  coachProfile        CoachProfile?
  organizationProfile OrganizationProfile?
  adminProfile        AdminProfile?

  // relations
  team_memberships    TeamMember[] 
  created_teams       Team[] @relation("CreatedTeams")
  payments            Payment[] 
  multimedia          Multimedia[]
  notification        Notification[]
  send_invites        TeamInvite[] @relation("InvitedByUser")
  received_invites    TeamInvite[] @relation("InvitedUser")
}

// ===============================
// Players & Guardians
// ===============================
model PlayerProfile {
  id              BigInt   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          BigInt   @unique
  preferred_games GameType[]
  guardianId      BigInt?
  guardian        Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  created_at      DateTime @default(now())
  bookings        PlayerBooking[]
  participants    Participant[]
}

model Guardian {
  id         BigInt @id @default(autoincrement())
  full_name  String 
  email      String @unique
  phone      String @unique
  relation   Relation @default(FATHER)
  created_at DateTime @default(now())
  players    PlayerProfile[]
}

// ===============================
// Coaches & Services
// ===============================
model CoachProfile {
  id          BigInt @id
  user        User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     BigInt @unique
  bio         String?
  experience  String?
  created_at  DateTime @default(now())
  services    CoachService[]
}

model CoachService {
  id          BigInt @id @default(autoincrement())
  coach       CoachProfile @relation(fields: [coach_id], references: [id], onDelete: Cascade)
  coach_id    BigInt
  title       String
  description String?
  price       Float? @default(0)
  duration    Int?
  created_at  DateTime @default(now())
  bookings    PlayerBooking[]
}

model PlayerBooking {
  id            BigInt @id @default(autoincrement())
  player        PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      BigInt
  service       CoachService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId     BigInt
  status        BookingStatus @default(REQUESTED)
  price         Float? @default(0)
  booked_at     DateTime @default(now())
  start_at      DateTime?   //
  end_at        DateTime?   
  notes         String?
  payments      Payment[]
}


// ===============================
// Teams
// ===============================
model Team {
  id            BigInt @id @default(autoincrement())
  name          String @unique
  logo          String?
  game          GameType
  created_by    User? @relation("CreatedTeams", fields: [created_by_id], references: [id])
  created_by_id BigInt?
  created_by_role UserRole
  created_at    DateTime @default(now())
  is_deleted    Boolean @default(false)

  members       TeamMember[]
  team_invites  TeamInvite[]
  participants  Participant[]
}

model TeamInvite {
  id             BigInt   @id @default(autoincrement())
  team           Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  team_id        BigInt
  invited        User     @relation("InvitedUser", fields: [invited_id], references: [id], onDelete: Cascade)
  invited_id     BigInt
  invited_role   UserRole 
  invited_email  String?
  invited_by     User     @relation("InvitedByUser", fields: [invited_by_id], references: [id], onDelete: Cascade)
  invited_by_id  BigInt
  status         ApprovalStatus @default(PENDING)
  created_at     DateTime @default(now())
  expires_at     DateTime?
}

model TeamMember {
  teamId       BigInt
  userId       BigInt
  roleInTeam   TeamMemberRole @default(PLAYER)
  invitedAt    DateTime @default(now())
  respondedAt  DateTime?
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

// ===============================
// Competitions
// ===============================
model CompetitionType {
  id                  BigInt @id @default(autoincrement())
  name                String
  rules               String
  sport               GameType
  createdByAdmin      BigInt?
  min_player_per_team Int
  max_player_per_team Int
  competitions        Competition[]
  created_at          DateTime @default(now())
}

model Competition {
  id                  BigInt @id @default(autoincrement())
  name                String
  type                CompetitionType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  typeId              BigInt
  start_date          DateTime
  end_date            DateTime
  venue_name          String
  venue_address       String
  venue_city          String
  organization        OrganizationProfile @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  organization_id     BigInt
  approval_status     ApprovalStatus @default(PENDING)
  fee_type            FeeType
  fee_amount          Float @default(0)
  is_fee_per_person   Boolean? @default(false)   
  winner_participant_id BigInt?  
  min_age             Int
  max_age             Int
  max_teams           Int?
  hasGroupStage       Boolean @default(false)
  eliminationType     EliminationType @default(SINGLE_ELIMINATION)
  created_at          DateTime @default(now())
  participants        Participant[]
  matches             Match[]
  groups              CompetitionGroup[]
  multimedia          Multimedia[]
}

model Participant {
  id           BigInt @id @default(autoincrement())
  competition  Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  competition_id BigInt
  type         ParticipantType
  team         Team? @relation(fields: [team_id], references: [id], onDelete: SetNull)
  team_id      BigInt?
  player       PlayerProfile? @relation(fields: [player_id], references: [id], onDelete: SetNull) 
  player_id    BigInt?
  registered_at DateTime @default(now())
  confirmed_at DateTime? 
  qrCode       String?
  payment_required Float?
  status       ApprovalStatus @default(PENDING)

  wonMatches   Match[] @relation("MatchWinner")
  group_memberships GroupMembership[]
  match_as_participant1 Match[] @relation("MatchParticipant1")
  match_as_participant2 Match[] @relation("MatchParticipant2")
  payments     Payment[]
  standing     GroupStanding[]

  @@unique([competition_id, team_id])
  @@unique([competition_id, player_id])
}

// ===============================
// Competition Groups
// ===============================
model CompetitionGroup {
  id             BigInt @id @default(autoincrement())
  competition    Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  competition_id BigInt
  name           String
  members        GroupMembership[]
  matches        Match[]
  standing       GroupStanding[]
}

model GroupMembership {
  group_id      BigInt
  participant_id BigInt
  points        Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)

  group        CompetitionGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  participant  Participant @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  @@id([group_id, participant_id])
}

// ===============================
// Matches
// ===============================
model Match {
  id           BigInt @id @default(autoincrement())
  competition_id BigInt
  competition    Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)

  group_id BigInt?
  group    CompetitionGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull)

  stage   MatchStage?
  status  MatchStatus @default(SCHEDULED)

  scheduled_at  DateTime?
  venue_name    String?
  venue_address String?
  venue_city    String?

  round          Int?
  next_match_id  BigInt?
  next_match_slot Int?

  participant1_id BigInt
  participant1    Participant @relation("MatchParticipant1", fields: [participant1_id], references: [id], onDelete: Cascade)

  participant2_id BigInt?
  participant2    Participant? @relation("MatchParticipant2", fields: [participant2_id], references: [id], onDelete: SetNull)

  score_participant1 Int? @default(0)
  score_participant2 Int? @default(0)

  winner_participant_id BigInt?
  winner Participant? @relation("MatchWinner", fields: [winner_participant_id], references: [id], onDelete: SetNull)

  nextMatch      Match?   @relation("NextMatch", fields: [next_match_id], references: [id], onDelete: SetNull)
  previousMatches Match[] @relation("NextMatch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupStanding {
  id             BigInt    @id @default(autoincrement())
  group          CompetitionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        BigInt
  participant    Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId  BigInt
  points         Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)

  @@unique([groupId, participantId])
}

// ===============================
// Payments
// ===============================
model Payment {
  id              BigInt @id @default(autoincrement())
  participant_id  BigInt?
  participant     Participant? @relation(fields: [participant_id], references: [id], onDelete: SetNull)

  bookingId       BigInt?
  booking         PlayerBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  user_id         BigInt
  user            User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  amount          Float @default(0)
  currency        String? @default("EGP")
  method          String?
  created_at      DateTime @default(now())
  due_date        DateTime?
  status          PaymentStatus @default(PENDING)
  payment_info    Json?
}

// ===============================
// Admin & Organization
// ===============================
model AdminProfile {
  id        BigInt @id
  user      User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   BigInt @unique
  created_t DateTime @default(now())
  approved_organizations OrganizationProfile[]
}

model OrganizationProfile {
  id             BigInt @id
  user           User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id        BigInt @unique
  owner_name     String
  type           OrganizationType
  district       String
  street_address String
  address_description String?
  google_map_link String?
  approval_status ApprovalStatus @default(PENDING)
  approved_by     BigInt?
  admin           AdminProfile? @relation(fields: [approved_by], references: [id], onDelete: SetNull)
  created_at      DateTime @default(now())
  competitions    Competition[]
}

// ===============================
// Multimedia & Notifications
// ===============================
model Multimedia {
  id             BigInt       @id @default(autoincrement())
  competition    Competition   @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  competition_id BigInt
  title          String
  description    String?
  media_type     MediaType
  url            String
  uploaded_by_id BigInt
  uploaded_by    User          @relation(fields: [uploaded_by_id], references: [id], onDelete: Cascade)
  created_at     DateTime      @default(now())
}


model Notification {
  id             BigInt   @id @default(autoincrement())
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id        BigInt
  firebase_token String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([user_id, firebase_token])
}
