generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  ORGANIZATION
  PLAYER
  COACH
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  FACEBOOK
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELED
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum Relation {
  FATHER
  MOTHER
  OTHER
}

enum ParticipantType {
  TEAM
  PLAYER
}

enum GameType {
  FOOTBALL
  BASKETBALL
  HANDBALL
  PLAYSTATION
}

enum EliminationType {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  KNOCKOUT
}

enum TeamMemberRole {
  PLAYER
  CAPTAIN
}

// ===============================
// Users
// ===============================
model User {
  id          BigInt   @id @default(autoincrement())
  firebaseUid String   @unique
  fullName    String
  email       String   @unique
  phone       String   @unique
  gender      Gender
  birthDate   DateTime @db.Date
  isActive    Boolean    @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //profiles
  playerProfile       PlayerProfile?
  coachProfile        CoachProfile?
  organizationProfile OrganizationProfile?
  adminProfile        AdminProfile?

  //relations
  createdTeams        Team[] @relation("CreatedTeams")
  payments            Payment[]
  multimedia   Multimedia[]
}

// ===============================
// Players & Guardians
// ===============================
model PlayerProfile {
  id            BigInt   @id
  user          User     @relation(fields: [userId], references: [id])
  userId        BigInt   @unique
  preferredGames GameType[]
  city          String
  guardianId    BigInt?
  guardian      Guardian? @relation(fields: [guardianId], references: [id])
  createdAt     DateTime @default(now())
  bookings      PlayerBooking[]
  teamMemberships TeamMember[]
}

model Guardian {
  id        BigInt @id @default(autoincrement())
  fullName  String 
  email     String @unique
  phone     String @unique
  relation  Relation @default(FATHER)
  createdAt DateTime @default(now())
  players   PlayerProfile[]
}

// ===============================
// Coaches & Services
// ===============================
model CoachProfile {
  id          BigInt @id
  user        User   @relation(fields: [userId], references: [id])
  userId      BigInt @unique
  bio         String?
  experience  String?
  createdAt   DateTime @default(now())
  services    CoachService[]
}


model CoachService {
  id          BigInt @id @default(autoincrement())
  coach       CoachProfile @relation(fields: [coachId], references: [id])
  coachId     BigInt
  title       String
  description String?
  price       Float? @default(0)
  duration    Int?
  createdAt   DateTime @default(now())
  bookings    PlayerBooking[]
}

model PlayerBooking {
  id           BigInt @id @default(autoincrement())
  player       PlayerProfile @relation(fields: [playerId], references: [id])
  playerId     BigInt
  service      CoachService @relation(fields: [serviceId], references: [id])
  serviceId    BigInt
  status       BookingStatus @default(REQUESTED)
  price        Float? @default(0)
  bookedAt     DateTime @default(now())
  scheduledAt  DateTime?
  notes        String?
  payments     Payment[]
}

// ===============================
// Teams
// ===============================
model Team {
  id          BigInt @id @default(autoincrement())
  name        String @unique
  logo        String?
  game        GameType
  createdBy   User? @relation("CreatedTeams", fields: [createdById], references: [id])
  createdById BigInt?
  createdAt   DateTime @default(now())
  members     TeamMember[]
  multimedia   Multimedia[]
}

model TeamMember {
  teamId       BigInt
  playerId     BigInt
  roleInTeam   TeamMemberRole @default(PLAYER)
  status       MembershipStatus @default(PENDING)
  invitedAt    DateTime @default(now())
  respondedAt  DateTime?
  team         Team @relation(fields: [teamId], references: [id])
  player       PlayerProfile @relation(fields: [playerId], references: [id])
  @@id([teamId, playerId])
  teamPayments TeamParticipantPayment[]
}

// ===============================
// Competitions
// ===============================
model CompetitionType {
  id              BigInt @id @default(autoincrement())
  name            String
  rules           String
  sport           String
  eliminationType EliminationType @default(SINGLE_ELIMINATION)
  createdByAdmin  BigInt?
  competitions    Competition[]
  createdAt       DateTime @default(now())
}

model Competition {
  id                BigInt @id @default(autoincrement())
  name              String
  type              CompetitionType @relation(fields: [typeId], references: [id])
  typeId            BigInt
  startDate         DateTime
  endDate           DateTime
  venueName         String
  venueAddress      String
  venueCity         String
  organization      OrganizationProfile @relation(fields: [organizationId], references: [id])
  organizationId    BigInt
  approvalStatus    ApprovalStatus @default(PENDING)
  price             Float @default(0)
  winnerParticipantId BigInt?  
  createdAt         DateTime @default(now())
  participants      Participant[]
  matches           Match[]
  groups            CompetitionGroup[]
  multimedia   Multimedia[]

   
}

model Participant {
  id           BigInt @id @default(autoincrement())
  competition  Competition @relation(fields: [competitionId], references: [id])
  competitionId BigInt
  type         ParticipantType
  teamId       BigInt?
  playerId     BigInt?
  registeredAt DateTime @default(now())
  qrCode       String?
  paymentRequired Float?

  teamParticipation TeamParticipantPayment[] @relation("ParticipantToMembers")
  groupMemberships  GroupMembership[]
  matchAsParticipant1 Match[] @relation("MatchParticipant1")
  matchAsParticipant2 Match[] @relation("MatchParticipant2")
  payments Payment[]

  @@unique([competitionId, teamId])
  @@unique([competitionId, playerId])
}

model TeamParticipantPayment {
  id           BigInt @id @default(autoincrement())
  participant  Participant @relation("ParticipantToMembers", fields: [participantId], references: [id])
  participantId BigInt

  teamId       BigInt
  playerId     BigInt
  teamMember   TeamMember @relation(fields: [teamId, playerId], references: [teamId, playerId])

  feeShare     Float
  isPaid       Boolean @default(false)
  dueDate      DateTime?
  
  payments     Payment[]
}

// ===============================
// Competition Groups
// ===============================
model CompetitionGroup {
  id           BigInt @id @default(autoincrement())
  competition  Competition @relation(fields: [competitionId], references: [id])
  competitionId BigInt
  name         String?
  members      GroupMembership[]
}

model GroupMembership {
  groupId       BigInt
  participantId BigInt
  points        Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)
  group         CompetitionGroup @relation(fields: [groupId], references: [id])
  participant   Participant @relation(fields: [participantId], references: [id])
  @@id([groupId, participantId])
}

// ===============================
// Matches
// ===============================
model Match {
  id                  BigInt @id @default(autoincrement())
  competition         Competition @relation(fields: [competitionId], references: [id])
  competitionId       BigInt
  stage               String?
  status              MatchStatus @default(SCHEDULED)
  scheduledAt         DateTime?
  venueName           String
  venueAddress        String
  venueCity           String
  participant1        Participant @relation("MatchParticipant1", fields: [participant1Id], references: [id])
  participant1Id      BigInt
  participant2        Participant @relation("MatchParticipant2", fields: [participant2Id], references: [id])
  participant2Id      BigInt
  scores              Json
  winnerParticipantId BigInt? // nullable for knockout
  createdAt           DateTime @default(now())
}

// ===============================
// Payments
// ===============================
model Payment {
  id                        BigInt @id @default(autoincrement())
  
  participantId             BigInt?
  participant               Participant? @relation(fields: [participantId], references: [id])

  teamParticipantPaymentId  BigInt?
  teamParticipantPayment    TeamParticipantPayment? @relation(fields: [teamParticipantPaymentId], references: [id])

  bookingId                 BigInt?
  booking                   PlayerBooking? @relation(fields: [bookingId], references: [id])

  userId                    BigInt
  user                      User @relation(fields: [userId], references: [id])

  amount                    Float
  currency                  String? @default("EGP")
  paymentDate               DateTime @default(now())
  dueDate                   DateTime?
  status                    PaymentStatus @default(PENDING)
  providerInfo              Json?
}

// ===============================
// Admin & Organization
// ===============================
model AdminProfile {
  id        BigInt @id
  user      User  @relation(fields: [userId], references: [id])
  userId    BigInt @unique
  createdAt DateTime @default(now())
}



model OrganizationProfile {
  id            BigInt @id
  user          User   @relation(fields: [userId], references: [id])
  userId        BigInt @unique
  ownerName     String
  approvalStatus ApprovalStatus @default(PENDING)
  approvedBy    BigInt
  createdAt     DateTime @default(now())
  competitions  Competition[]
}

// ===============================
//  MultiMedia 
// ===============================

model Multimedia {
  id             BigInt     @id @default(autoincrement())
  competition    Competition? @relation(fields: [competitionId], references: [id])
  competitionId  BigInt?
  team           Team?       @relation(fields: [teamId], references: [id])
  teamId         BigInt?
  title          String
  description    String?
  mediaType      MediaType   
  url            String      
  uploadedById   BigInt      
  uploadedBy     User        @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime    @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}
