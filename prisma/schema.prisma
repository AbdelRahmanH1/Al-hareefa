generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  ORGANIZATION
  PLAYER
  COACH
}

enum AuthProvider {
  EMAIL
  PHONE
  GOOGLE
  FACEBOOK
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELED
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum Relation {
  FATHER
  MOTHER
  OTHER
}



enum GameType {
  FOOTBALL
  BASKETBALL
  HANDBALL
  PLAYSTATION
}

enum EliminationType {
  SINGLE_ELIMINATION
  KNOCKOUT
}

enum MatchStage {
  GROUP_STAGE
  FIRST_ELIMINATION
  SECOND_ELIMINATION
  FINAL
}


enum TeamMemberRole {
  PLAYER
  CAPTAIN
}




// ===============================
// Users
// ===============================
model User {
  id          BigInt   @id @default(autoincrement())
  firebase_id String   @unique
  full_name    String
  email       String   @unique
  phone       String   @unique
  gender      Gender
  role  UserRole
  city          String
  birth_date   DateTime @db.Date
  is_active    Boolean    @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  //profiles
  playerProfile       PlayerProfile?
  coachProfile        CoachProfile?
  organizationProfile OrganizationProfile?
  adminProfile        AdminProfile?

  //relations
  created_teams        Team[] @relation("CreatedTeams")
  payments            Payment[]
  multimedia   Multimedia[]
  notification Notification[]
  send_invites TeamInvite[] @relation("InvitedByUser")
  received_invites TeamInvite[] @relation("InvitedUser")

}

// ===============================
// Players & Guardians
// ===============================
model PlayerProfile {
  id            BigInt   @id
  user          User     @relation(fields: [userId], references: [id])
  userId        BigInt   @unique
  preferred_games GameType[]
  guardianId    BigInt?
  guardian      Guardian? @relation(fields: [guardianId], references: [id],onDelete: SetNull)
  created_at     DateTime @default(now())
  bookings      PlayerBooking[]
  team_memberships TeamMember[]
  participants Participant[]

}

model Guardian {
  id        BigInt @id @default(autoincrement())
  full_name  String 
  email     String @unique
  phone     String @unique
  relation  Relation @default(FATHER)
  created_at DateTime @default(now())
  players   PlayerProfile[]
}

// ===============================
// Coaches & Services
// ===============================
model CoachProfile {
  id          BigInt @id
  user        User   @relation(fields: [user_id], references: [id])
  user_id      BigInt @unique
  bio         String?
  experience  String?
  created_at   DateTime @default(now())
  services    CoachService[]
}


model CoachService {
  id          BigInt @id @default(autoincrement())
  coach       CoachProfile @relation(fields: [coach_id], references: [id])
  coach_id     BigInt
  title       String
  description String?
  price       Float? @default(0)
  duration    Int?
  created_at   DateTime @default(now())
  bookings    PlayerBooking[]
}

model PlayerBooking {
  id           BigInt @id @default(autoincrement())
  player       PlayerProfile @relation(fields: [playerId], references: [id])
  playerId     BigInt
  service      CoachService @relation(fields: [serviceId], references: [id])
  serviceId    BigInt
  status       BookingStatus @default(REQUESTED)
  price        Float? @default(0)
  booked_at    DateTime @default(now())
  scheduled_at  DateTime?
  notes        String?
  payments     Payment[]
}

// ===============================
// Teams
// ===============================
model Team {
  id          BigInt @id @default(autoincrement())
  name        String @unique
  logo        String?
  game        GameType
  created_by   User? @relation("CreatedTeams", fields: [created_by_id], references: [id])
  created_by_id BigInt?
  created_by_role UserRole
  created_at   DateTime @default(now())
  is_deleted Boolean @default(false)

  members     TeamMember[]
  multimedia   Multimedia[]
  team_invites TeamInvite[]
  participants Participant[]

}

model TeamInvite {
  id          BigInt   @id @default(autoincrement())
  
  team        Team     @relation(fields: [team_id], references: [id])
  team_id     BigInt
  
  invited     User     @relation("InvitedUser", fields: [invited_id], references: [id])
  invited_id  BigInt
  
  invited_role UserRole 
  invited_email  String?
  invited_by   User       @relation("InvitedByUser", fields: [invited_by_id], references: [id])
  invited_by_id BigInt
  
  status       ApprovalStatus @default(PENDING)
  
  created_at   DateTime @default(now())
  expires_at   DateTime?
}



model TeamMember {
  teamId       BigInt
  playerId     BigInt
  roleInTeam   TeamMemberRole @default(PLAYER)
  invitedAt    DateTime @default(now())
  respondedAt  DateTime?
  team         Team @relation(fields: [teamId], references: [id])
  player       PlayerProfile @relation(fields: [playerId], references: [id])
  @@id([teamId, playerId])
}

// ===============================
// Competitions
// ===============================
model CompetitionType {
  id              BigInt @id @default(autoincrement())
  name            String
  rules           String
  sport           GameType
  createdByAdmin  BigInt?
  min_player_per_team Int
  max_player_per_team Int
  competitions    Competition[]
  created_at       DateTime @default(now())
}

enum FeeType {
  SINGLE             
  TEAM_SINGLE_FEE     
}

enum ParticipantType {
  TEAM
  PLAYER
}
model Competition {
  id                  BigInt @id @default(autoincrement())
  name                String
  type                CompetitionType @relation(fields: [typeId], references: [id])
  typeId              BigInt
  start_date          DateTime
  end_date            DateTime
  venue_name          String
  venue_address       String
  venue_city          String
  organization        OrganizationProfile @relation(fields: [organization_id], references: [id])
  organization_id     BigInt
  approval_status     ApprovalStatus @default(PENDING)
  fee_type            FeeType
  fee_amount          Float?
  is_fee_per_person   Boolean? @default(false)   
  winner_participant_id BigInt?  
  min_age             Int
  max_age             Int
  max_teams           Int?
  hasGroupStage    Boolean @default(false)
  eliminationType     EliminationType @default(SINGLE_ELIMINATION)
  created_at          DateTime @default(now())
  participants        Participant[]
  matches             Match[]
  groups              CompetitionGroup[]
  multimedia          Multimedia[]
}

model Participant {
  id           BigInt @id @default(autoincrement())
  competition  Competition @relation(fields: [competition_id], references: [id])
  competition_id BigInt
  type         ParticipantType
  team        Team? @relation(fields: [team_id], references: [id])
  team_id       BigInt?

  player       PlayerProfile? @relation(fields: [player_id], references: [id]) // 👈 ADD THIS
player_id     BigInt?
  registered_at DateTime @default(now())
  confirmed_at   DateTime? 
  qrCode       String?
  payment_required Float?
  status ApprovalStatus @default(PENDING)
  wonMatches Match[] @relation("MatchWinner")
  group_memberships  GroupMembership[]
  match_as_participant1 Match[] @relation("MatchParticipant1")
  match_as_participant2 Match[] @relation("MatchParticipant2")
  payments Payment[]

  @@unique([competition_id, team_id])
  @@unique([competition_id, player_id])
}



// ===============================
// Competition Groups
// ===============================
model CompetitionGroup {
  id           BigInt @id @default(autoincrement())
  competition  Competition @relation(fields: [competition_id], references: [id])
  competition_id BigInt
  name         String
  members      GroupMembership[]
  matches Match[]
}

model GroupMembership {
  group_id       BigInt
  participant_id BigInt
  points        Int @default(0)
  wins          Int @default(0)
  losses        Int @default(0)
  group         CompetitionGroup @relation(fields: [group_id], references: [id])
  participant   Participant @relation(fields: [participant_id], references: [id])
  @@id([group_id, participant_id])
}

// ===============================
// Matches
// ===============================
model Match {
  id           BigInt @id @default(autoincrement())
  
  competition_id BigInt
  competition    Competition @relation(fields: [competition_id], references: [id])

  group_id BigInt?
  group    CompetitionGroup? @relation(fields: [group_id], references: [id])

  stage   MatchStage?
  status  MatchStatus @default(SCHEDULED)

  scheduled_at  DateTime?
  venue_name    String?
  venue_address String?
  venue_city    String?

  round          Int?
  next_match_id  BigInt?
  next_match_slot Int?

  participant1_id BigInt
  participant1    Participant @relation("MatchParticipant1", fields: [participant1_id], references: [id])

  participant2_id BigInt
  participant2    Participant @relation("MatchParticipant2", fields: [participant2_id], references: [id])

  score_participant1 Int? @default(0)
  score_participant2 Int? @default(0)

  winner_participant_id BigInt?
  winner Participant? @relation("MatchWinner", fields: [winner_participant_id], references: [id])

  nextMatch      Match?   @relation("NextMatch", fields: [next_match_id], references: [id])
  previousMatches Match[] @relation("NextMatch")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ===============================
// Payments
// ===============================
model Payment {
  id                        BigInt @id @default(autoincrement())
  
  participant_id             BigInt?
  participant               Participant? @relation(fields: [participant_id], references: [id])


  bookingId                 BigInt?
  booking                   PlayerBooking? @relation(fields: [bookingId], references: [id])

  user_id                    BigInt
  user                      User @relation(fields: [user_id], references: [id])

  amount                    Float
  currency                  String? @default("EGP")
  method                    String?
  created_at               DateTime @default(now())
  due_date                   DateTime?
  status                    PaymentStatus @default(PENDING)
  payment_info                 Json?
}

// ===============================
// Admin & Organization
// ===============================
model AdminProfile {
  id        BigInt @id
  user      User  @relation(fields: [user_id], references: [id])
  user_id    BigInt @unique
  created_t DateTime @default(now())
  approved_organizations OrganizationProfile[]
}

enum OrganizationType {
  CLUB
  YOUTH_CENTER
  STATUDIM
}

model OrganizationProfile {
  id             BigInt @id
  user           User   @relation(fields: [user_id], references: [id])
  user_id         BigInt @unique
  owner_name      String
  type  OrganizationType
  district        String
  street_address String
  address_description String?
  google_map_link String?
  approval_status ApprovalStatus @default(PENDING)
  approved_by     BigInt?
  admin          AdminProfile? @relation(fields: [approved_by], references: [id], onDelete: SetNull)
  created_at      DateTime @default(now())
  competitions   Competition[]
}


// ===============================
//  MultiMedia 
// ===============================

model Multimedia {
  id             BigInt     @id @default(autoincrement())
  competition    Competition? @relation(fields: [competition_id], references: [id])
  competition_id  BigInt?
  team           Team?       @relation(fields: [team_id], references: [id])
  team_id         BigInt?
  title          String
  description    String?
  media_type      MediaType   
  url            String      
  uploaded_by_id   BigInt      
  uploaded_by     User        @relation(fields: [uploaded_by_id], references: [id])
  created_at      DateTime    @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Notification {
  id             BigInt   @id @default(autoincrement())
  user           User     @relation(fields: [user_id], references: [id])
  user_id        BigInt
  firebase_token String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  @@unique([user_id, firebase_token])

}